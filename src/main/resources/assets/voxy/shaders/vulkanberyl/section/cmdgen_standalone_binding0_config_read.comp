#version 460

layout(local_size_x = 128) in;

struct DrawCommand {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
};

layout(binding = 0, std430) readonly volatile buffer RenderListBuffer {
    uint visibleCount;
    uint indirectLookup[];
};
layout(binding = 1, std430) readonly buffer MetadataBuffer {
    uvec4 sectionData[];
};
layout(binding = 2, std430) readonly buffer CmdGenUnusedBinding2 {
    uint unusedBinding2Words[];
};
layout(binding = 3, std430) writeonly buffer DrawCommandsBuffer {
    DrawCommand commands[];
};
layout(binding = 4, std430) buffer DrawCountBuffer {
    uint drawCount;
};
layout(binding = 5, std430) readonly volatile buffer CmdGenConfigBuffer {
    uint metadataSectionCapacity;
    uint renderListCapacity;
    uint geometryCapacityQuads;
    uint drawCommandCapacity;
    uint drawCountCapacityWords;
    uint flags;
};

void main() {
    uint configFlags = flags;
    uint binding0VisibleCount = visibleCount;
    uint keepAlive = configFlags ^ binding0VisibleCount;
    if (keepAlive == 0xffffffffu) {
        uint stillLocal = keepAlive ^ configFlags;
        keepAlive = stillLocal;
    }
}
