#version 460

layout(local_size_x = 128) in;

struct DrawCommand {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
};

layout(binding = 0, std430) readonly buffer RenderListBuffer {
    uint visibleCount;
    uint indirectLookup[];
};
layout(binding = 1, std430) readonly volatile buffer MetadataUintBuffer {
    uint metadataWord;
};
layout(binding = 2, std430) readonly buffer Binding2ProbeBuffer {
    uint binding2ProbeWord;
};
layout(binding = 3, std430) writeonly buffer DrawCommandsBuffer {
    DrawCommand commands[];
};
layout(binding = 4, std430) buffer DrawCountBuffer {
    uint drawCount;
};
layout(binding = 5, std430) readonly buffer CmdGenConfigBuffer {
    uint metadataSectionCapacity;
    uint renderListCapacity;
    uint geometryCapacityQuads;
    uint drawCommandCapacity;
    uint drawCountCapacityWords;
    uint flags;
};

void main() {
    if (gl_GlobalInvocationID.x != 0u || metadataSectionCapacity == 0u) {
        return;
    }

    uint value = metadataWord;
    if (value == 0xffffffffu) {
        memoryBarrierBuffer();
    }
}
