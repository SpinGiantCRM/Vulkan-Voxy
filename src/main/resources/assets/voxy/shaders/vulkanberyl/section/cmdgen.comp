#version 460

layout(local_size_x = 128) in;

#import <voxy:lod/section.glsl>

struct DrawCommand {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
};

layout(binding = 0, std430) readonly volatile buffer RenderListBuffer {
    uint visibleCount;
    uint indirectLookup[];
};
layout(binding = 1, std430) readonly buffer MetadataBuffer {
    SectionMeta sectionData[];
};
// Unused binding2 padding keeps Beryl's dense ManualUBO descriptor layout at bindings 0..5.
layout(binding = 2, std430) readonly buffer CmdGenUnusedBinding2 {
    uint unusedBinding2Word;
};
layout(binding = 3, std430) writeonly buffer DrawCommandsBuffer {
    DrawCommand commands[];
};
layout(binding = 4, std430) buffer DrawCountBuffer {
    uint drawCount;
};
layout(binding = 5, std430) readonly buffer CmdGenConfigBuffer {
    uint metadataSectionCapacity;
    uint renderListCapacity;
    uint geometryCapacityQuads;
    uint drawCommandCapacity;
    uint drawCountCapacityWords;
    uint flags;
};

const uint CMDGEN_FLAG_NOOP_SMOKE = 1u;
const uint CMDGEN_FLAG_READ_RENDERLIST_ONLY = 1u << 1u;
const uint CMDGEN_FLAG_READ_METADATA_ONLY = 1u << 2u;
const uint CMDGEN_FLAG_WRITE_DRAWS_ONLY = 1u << 3u;
const uint CMDGEN_FLAG_READ_RENDERLIST_HEADER_ONLY = 1u << 4u;
const uint CMDGEN_FLAG_READ_RENDERLIST_COUNT_ONLY = 1u << 5u;
const uint CMDGEN_FLAG_READ_RENDERLIST_ENTRY0_SECTION_ID_ONLY = 1u << 6u;
const uint CMDGEN_FLAG_READ_RENDERLIST_ENTRY0_QUAD_START_ONLY = 1u << 7u;
const uint CMDGEN_FLAG_READ_RENDERLIST_ENTRY0_QUAD_COUNT_ONLY = 1u << 8u;
const uint CMDGEN_FLAG_READ_BINDING0_ONLY = 1u << 9u;
const uint CMDGEN_FLAG_READ_BINDING1_ONLY = 1u << 10u;
const uint CMDGEN_FLAG_READ_BINDING0_ONLY_NO_OUTPUT_WRITE = 1u << 11u;
const uint CMDGEN_FLAG_READ_CONFIG_ONLY = 1u << 12u;
const uint CMDGEN_FLAG_READ_RENDERLIST_METADATA_NO_WRITE = 1u << 13u;


uint extractTranslucentQuadCount(SectionMeta meta) {
    return meta.b.x & 0xFFFFu;
}

uint extractOpaqueQuadCount(SectionMeta meta) {
    uvec4 counts = meta.b;
    return ((counts.x >> 16u) & 0xFFFFu)
        + (counts.y & 0xFFFFu)
        + ((counts.y >> 16u) & 0xFFFFu)
        + (counts.z & 0xFFFFu)
        + ((counts.z >> 16u) & 0xFFFFu)
        + (counts.w & 0xFFFFu)
        + ((counts.w >> 16u) & 0xFFFFu);
}

void writeZeroCommand(uint commandIndex) {
    DrawCommand cmd;
    cmd.vertexCount = 0u;
    cmd.instanceCount = 0u;
    cmd.firstVertex = 0u;
    cmd.firstInstance = 0u;
    commands[commandIndex] = cmd;
}

void main() {
    uint drawIndex = gl_GlobalInvocationID.x;

    // CMDGEN_FLAG_READ_CONFIG_ONLY: read config fields only, no renderList/metadata/commands access
    if ((flags & CMDGEN_FLAG_READ_CONFIG_ONLY) != 0u) {
        if (drawIndex != 0u) {
            return;
        }
        // Read config binding fields into locals so reads are not trivially removed
        uint localMetadataCapacity = metadataSectionCapacity;
        uint localRenderListCapacity = renderListCapacity;
        uint localGeometryCapacity = geometryCapacityQuads;
        uint localDrawCommandCapacity = drawCommandCapacity;
        uint localDrawCountCapacity = drawCountCapacityWords;
        uint localFlags = flags;
        // Use the locals to prevent optimization
        if ((localMetadataCapacity | localRenderListCapacity | localGeometryCapacity |
             localDrawCommandCapacity | localDrawCountCapacity | localFlags) == 0xffffffffu) {
            uint ignored = localMetadataCapacity;
        }
        return;
    }

    // CMDGEN_FLAG_READ_RENDERLIST_METADATA_NO_WRITE: read renderList[0] and metadata only, no writes
    if ((flags & CMDGEN_FLAG_READ_RENDERLIST_METADATA_NO_WRITE) != 0u) {
        if (drawIndex != 0u) {
            return;
        }
        // Only read renderList[0] if capacity > 0
        if (renderListCapacity > 0u) {
            uint sectionId = indirectLookup[0];
            // Read metadata only if sectionId is valid
            if (sectionId < metadataSectionCapacity) {
                SectionMeta meta = sectionData[sectionId];
                uint quadStart = extractQuadStart(meta);
                uint translucentCount = extractTranslucentQuadCount(meta);
                uint opaqueQuadStart = quadStart + translucentCount;
                uint opaqueQuadCount = extractOpaqueQuadCount(meta);
                // Compute values locally but do not write commands or drawCount
                if ((quadStart | opaqueQuadStart | opaqueQuadCount) == 0xffffffffu) {
                    uint ignored = quadStart;
                }
            }
        }
        return;
    }

    if ((flags & CMDGEN_FLAG_NOOP_SMOKE) != 0u) {
        if (drawIndex == 0u && drawCountCapacityWords > 0u) {
            drawCount = 0u;
        }
        return;
    }

    if ((flags & CMDGEN_FLAG_READ_BINDING0_ONLY_NO_OUTPUT_WRITE) != 0u) {
        if (drawIndex != 0u) {
            return;
        }
        uint binding0Smoke = visibleCount;
        if (binding0Smoke == 0xffffffffu) {
            uint ignored = binding0Smoke;
        }
        return;
    }

    if ((flags & CMDGEN_FLAG_READ_BINDING0_ONLY) != 0u) {
        if (drawIndex != 0u) {
            return;
        }
        uint binding0Smoke = visibleCount;
        if (binding0Smoke == 0xffffffffu && drawCountCapacityWords > 0u) {
            drawCount = 0u;
        }
        return;
    }

    if ((flags & CMDGEN_FLAG_READ_BINDING1_ONLY) != 0u) {
        if (drawIndex != 0u) {
            return;
        }
        uint binding1Smoke = sectionData[0].a.x;
        if (binding1Smoke == 0xffffffffu && drawCountCapacityWords > 0u) {
            drawCount = 0u;
        }
        return;
    }


    if ((flags & CMDGEN_FLAG_READ_RENDERLIST_HEADER_ONLY) != 0u) {
        if (drawIndex != 0u) {
            return;
        }
        uint headerSmoke = visibleCount;
        if (headerSmoke == 0xffffffffu && drawCountCapacityWords > 0u) {
            drawCount = 0u;
        }
        return;
    }

    if ((flags & CMDGEN_FLAG_READ_RENDERLIST_COUNT_ONLY) != 0u) {
        if (drawIndex != 0u) {
            return;
        }
        uint countSmoke = visibleCount;
        if (countSmoke == 0xffffffffu && drawCountCapacityWords > 0u) {
            drawCount = 0u;
        }
        return;
    }

    if ((flags & CMDGEN_FLAG_READ_RENDERLIST_ENTRY0_SECTION_ID_ONLY) != 0u) {
        if (drawIndex != 0u) {
            return;
        }
        uint sectionIdSmoke = indirectLookup[0];
        if (sectionIdSmoke == 0xffffffffu && drawCountCapacityWords > 0u) {
            drawCount = 0u;
        }
        return;
    }

    if ((flags & CMDGEN_FLAG_READ_RENDERLIST_ENTRY0_QUAD_START_ONLY) != 0u) {
        if (drawIndex != 0u) {
            return;
        }
        uint quadStartSmoke = indirectLookup[1];
        if (quadStartSmoke == 0xffffffffu && drawCountCapacityWords > 0u) {
            drawCount = 0u;
        }
        return;
    }

    if ((flags & CMDGEN_FLAG_READ_RENDERLIST_ENTRY0_QUAD_COUNT_ONLY) != 0u) {
        if (drawIndex != 0u) {
            return;
        }
        uint quadCountSmoke = indirectLookup[2];
        if (quadCountSmoke == 0xffffffffu && drawCountCapacityWords > 0u) {
            drawCount = 0u;
        }
        return;
    }

    uint safeVisibleCount = min(min(visibleCount, renderListCapacity), drawCommandCapacity);
    if ((flags & CMDGEN_FLAG_READ_RENDERLIST_ONLY) != 0u) {
        if (drawIndex == 0u && safeVisibleCount > 0u) {
            uint sectionIdSmoke = indirectLookup[0];
            if (drawCountCapacityWords > 0u) {
                drawCount = min(sectionIdSmoke, 0u);
            }
        }
        return;
    }

    if (drawIndex >= safeVisibleCount) {
        return;
    }

    // The Java draw submission can consume every command slot below safeVisibleCount.
    // Publish only the number of command slots this shader will initialise, and make
    // invalid entries explicit no-op commands so stale data is never submitted.
    if (drawIndex == 0u && drawCountCapacityWords > 0u) {
        drawCount = safeVisibleCount;
    }

    uint sectionId = indirectLookup[drawIndex];
    if (sectionId >= metadataSectionCapacity) {
        writeZeroCommand(drawIndex);
        return;
    }

    SectionMeta meta = sectionData[sectionId];
    if ((flags & CMDGEN_FLAG_READ_METADATA_ONLY) != 0u) {
        if (drawIndex == 0u && drawCountCapacityWords > 0u) {
            drawCount = min(extractQuadStart(meta), 0u);
        }
        return;
    }
    if ((flags & CMDGEN_FLAG_WRITE_DRAWS_ONLY) != 0u) {
        if (drawIndex == 0u) {
            DrawCommand dummy;
            dummy.vertexCount = 0u;
            dummy.instanceCount = 0u;
            dummy.firstVertex = 0u;
            dummy.firstInstance = 0u;
            commands[0] = dummy;
            if (drawCountCapacityWords > 0u) {
                drawCount = 0u;
            }
        }
        return;
    }
    uint translucentQuadCount = extractTranslucentQuadCount(meta);
    uint opaqueQuadCount = extractOpaqueQuadCount(meta);
    uint opaqueQuadStart = extractQuadStart(meta) + translucentQuadCount;
    if (opaqueQuadCount == 0u || opaqueQuadStart > geometryCapacityQuads || opaqueQuadCount > geometryCapacityQuads - opaqueQuadStart) {
        writeZeroCommand(drawIndex);
        return;
    }

    DrawCommand cmd;
    cmd.vertexCount = opaqueQuadCount * 6u;
    cmd.instanceCount = 1u;
    cmd.firstVertex = 0u;
    cmd.firstInstance = drawIndex;
    commands[drawIndex] = cmd;

}
