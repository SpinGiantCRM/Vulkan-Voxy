#version 460 core

#define HIZ_BINDING 0
#define SCENE_UNIFORM_BINDING 1
#define REQUEST_QUEUE_BINDING 2
#define RENDER_QUEUE_BINDING 3
#define NODE_DATA_BINDING 4
#define NODE_QUEUE_INDEX_BINDING 5
#define NODE_QUEUE_META_BINDING 6
#define NODE_QUEUE_SOURCE_BINDING 7
#define NODE_QUEUE_SINK_BINDING 8
#define RENDER_TRACKER_BINDING 9
#define MAX_ITERATIONS 17

layout(local_size_x=32) in;

// Keeps an explicit smoke-only Hi-Z declaration so VOXY_VULKAN_BERYL_TRAVERSAL_SHADER_SMOKE=true
// can isolate sampler2D binding 0 versus Java's smoke-only dummy descriptor.
layout(binding = HIZ_BINDING) uniform sampler2D hizDepthSampler;

layout(binding = SCENE_UNIFORM_BINDING, std140) uniform SceneUniform {
    mat4 MVP;
    ivec3 camSecPos;
    uint packedHizSize;
    vec3 camSubSecPos;
    float minSSS;
    vec4 frustumPlanes[6];
    uint renderQueueMaxSize;
    uint frameId;
    uint requestQueueSize;
    uint maxNodeCount;
    float renderDistance;
};

layout(binding = REQUEST_QUEUE_BINDING, std430) restrict buffer requestQueueStruct {
    uvec2 requestQueueIndex;
    uvec2[] requestQueue;
};

layout(binding = RENDER_QUEUE_BINDING, std430) restrict buffer renderQueueStruct {
    uint renderQueueIndex;
    uint[] renderQueue;
};

layout(binding = NODE_DATA_BINDING, std430) restrict buffer NodeData {
    uvec4[] nodes;
};

layout(binding = NODE_QUEUE_INDEX_BINDING, std430) restrict readonly buffer NodeQueueIndex {
    uint queueIdx;
};

layout(binding = NODE_QUEUE_META_BINDING, std430) restrict buffer NodeQueueMeta {
    uvec4 nodeQueueMetadata[MAX_ITERATIONS];
};

layout(binding = NODE_QUEUE_SOURCE_BINDING, std430) restrict readonly buffer NodeQueueSource {
    uint[] nodeQueueSource;
};

layout(binding = NODE_QUEUE_SINK_BINDING, std430) restrict writeonly buffer NodeQueueSink {
    uint[] nodeQueueSink;
};

layout(binding = RENDER_TRACKER_BINDING, std430) restrict writeonly buffer renderTrackerArray {
    uint[] lastRenderFrame;
};

void main() {
    if (gl_GlobalInvocationID.x != 0u) {
        return;
    }

    uint stageLimit = frameId;
    if (stageLimit <= 1u) {
        return;
    }

    if (frameId == 0x48495A30u) { // "HIZ0": keep binding 0 active for descriptor-layout isolation.
        renderQueueIndex = uint(textureQueryLevels(hizDepthSampler));
        return;
    }

    bool uniformSmoke = (frameId == 0x53554D4Bu); // "SUMK"
    if (uniformSmoke) {
        if (renderQueueMaxSize > 0u && requestQueueSize <= 50u && maxNodeCount > 0u && minSSS > 0.0 && renderDistance > 0.0) {
            requestQueueIndex.x = 0u;
            renderQueueIndex = 0u;
        } else {
            requestQueueIndex.x = 0xBAD00001u;
            renderQueueIndex = 0xBAD00002u;
        }
        return;
    }

    requestQueueIndex.x = 0u;
    renderQueueIndex = 0u;
}
