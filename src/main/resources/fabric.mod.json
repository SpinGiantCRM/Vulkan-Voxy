{
  "schemaVersion": 1,
  "id": "voxy",
  "version": "${version}",
  "custom": {
    "commit": "${commit}",
    "buildtime": "${buildtime}"
  },
  "name": "Vulkan-Voxy",
  "description": "Vulkan/Beryl fork of Voxy for far distance LoD rendering",
  "authors": [
    "Cortex"
  ],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/voxy/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.cortex.voxy.client.VoxyClient"
    ],
    "main": [
      "me.cortex.voxy.commonImpl.VoxyCommon"
    ]
  },
  "mixins": [
    {
      "config": "client.voxy.mixins.json",
      "environment": "client"
    },
    "common.voxy.mixins.json"
  ],
  "depends": {
    "minecraft": "=26.1.2",
    "fabricloader": ">=0.18.6",
    "fabric-api": ">=0.145.3+26.1.1",
    "vulkanmod": ">=0.6.5",
    "beryl": ">=0.1.3-alpha+1"
  },
  "breaks": {
    "voxyworldgenv2": "=2.2.2"
  },
  "accessWidener": "voxy.accesswidener"
}
